# Zigbee Host Configuration
# Copy this file to .env and provide local values. Never commit .env.

# Required shared bearer token. Generate one with: openssl rand -hex 32
ZIGBEE_HOST_TOKEN=

# Container defaults normally do not need changing.
ZIGBEE_HOST_ADDRESS=0.0.0.0
ZIGBEE_HOST_PORT=47831
ZIGBEE_ADAPTER=/dev/zigbee
ZIGBEE_DATA_DIR=/data
ZIGBEE_RUNTIME_DIR=/data/runtime
ZIGBEE_LOG_DIR=/data/logs
