# Zigbee Host Configuration
# Copy this file to .env and provide local values. Never commit .env.

# Required shared bearer token. Generate one with: openssl rand -hex 32
ZIGBEE_HOST_TOKEN=

# Container defaults normally do not need changing.
ZIGBEE_HOST_ADDRESS=0.0.0.0
ZIGBEE_HOST_PORT=47831
ZIGBEE_ADAPTER=/dev/zigbee
ZIGBEE_DATA_DIR=/data
ZIGBEE_RUNTIME_DIR=/data/runtime
ZIGBEE_LOG_DIR=/data/logs
ZIGBEE_WARM_ENABLED=1
ZIGBEE_WARM_INTERVAL_SECONDS=30
ZIGBEE_WARM_JITTER_MS=2000
ZIGBEE_WARM_CONCURRENCY=2
ZIGBEE_WARM_SLOW_READ_MS=500
ZIGBEE_WARM_PROPERTY=brightness

# Optional structured diagnostics for 24-hour Zigbee timing/reachability captures.
ZIGBEE_DIAG_ENABLED=0
ZIGBEE_DIAG_SNAPSHOT_INTERVAL_SECONDS=300
# Leave empty to capture all devices, or set comma/space separated IEEE addresses.
ZIGBEE_DIAG_DEVICE_IDS=
# Defaults to $ZIGBEE_LOG_DIR/diagnostics when unset.
ZIGBEE_DIAG_DIR=
